<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_back"
            android:layout_margin="@dimen/m"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="@string/history_details_title"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:layout_margin="@dimen/m"
            android:textSize="@dimen/tx_xxxxl" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/xl">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/xl"
            app:cardElevation="@dimen/xxxs">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/xl"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHistoryName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/workout_placeholder"
                    android:textStyle="bold"
                    android:textSize="@dimen/tx_xxxl"
                    android:textColor="@color/orange"
                    android:layout_marginBottom="@dimen/xs"/>

                <TextView
                    android:id="@+id/tvHistoryType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/type_placeholder"
                    android:textSize="@dimen/tx_l"
                    android:layout_marginBottom="@dimen/xs"/>

                <TextView
                    android:id="@+id/tvHistoryDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/duration_placeholder"
                    android:textSize="@dimen/tx_l"
                    android:layout_marginBottom="@dimen/xs"/>

                <TextView
                    android:id="@+id/tvHistoryDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/completed_dt_placeholder"
                    android:textSize="@dimen/tx_l"
                    android:layout_marginBottom="@dimen/xs"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/xs"
            android:text="@string/exercises"
            android:textStyle="bold"
            android:textSize="@dimen/tx_xl"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHistoryExercises"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mbDeleteHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/delete"
        android:textStyle="bold"
        android:backgroundTint="@color/orange"
        app:cornerRadius="@dimen/m"
        android:layout_margin="@dimen/xl"/>

</LinearLayout>
