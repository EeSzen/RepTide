<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/s"
    app:cardCornerRadius="@dimen/l"
    app:cardElevation="@dimen/xxxs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/xl">

        <TextView
            android:id="@+id/tvExerciseName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/exercise_placeholder"
            android:textStyle="bold"
            android:textSize="@dimen/tx_xxl"
            android:textColor="@color/orange"
            android:layout_marginBottom="@dimen/xxs"/>

        <TextView
            android:id="@+id/tvExerciseCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/type_placeholder"
            android:textColor="@color/grey"
            android:textSize="@dimen/tx_m" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
